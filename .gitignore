# 2. Data Mentah (WAJIB - Biar RAB Dukuh Raya nggak tersebar ke publik)
data_source/
*.csv
*.xlsx
*.xls

# 3. Python Cache & Logs (Biar repo lu nggak penuh sampah)
__pycache__/
*.py[cod]
*$py.class
*.log

# 4. Virtual Environment (Kalau nanti lu bikin venv di laptop)
.venv/
venv/
env/

# 5. Knowledge graph hasil /graphify (dibangun ulang, isinya path absolut mesin lokal)
graphify-out/

# 6. Setelan Claude Code per-mesin (permission Bash), bukan keputusan proyek
.claude/settings.local.json
